{
  "name": "@tonehub/library-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first sync engine + canonical library types for CubeControl",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./supabase": {
