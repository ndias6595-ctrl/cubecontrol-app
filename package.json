{
  "name": "tonehub-app",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "desktop": "pnpm --filter @tonehub/desktop dev",
    "desktop:build": "pnpm --filter @tonehub/desktop build",
    "desktop:dist": "pnpm --filter @tonehub/desktop dist",
    "desktop:dist:dir": "pnpm --filter @tonehub/desktop dist:dir",
    "mobile": "pnpm --filter @tonehub/mobile start",
    "mobile:web": "pnpm --filter @tonehub/mobile web",
    "mobile:android": "pnpm --filter @tonehub/mobile android",
    "typecheck": "pnpm --filter @tonehub/desktop --filter @tonehub/mobile --filter @tonehub/library-sync --if-present typecheck"
  },
  "devDependencies": {
    "playwright": "1.49.1"
  }
}
