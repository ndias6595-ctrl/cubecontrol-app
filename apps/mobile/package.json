{
  "name": "@tonehub/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ./scripts/start-wifi.mjs",
    "start:usb": "expo start --dev-client --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "android:device": "node ./scripts/run-android-device.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.2",
    "@expo-google-fonts/syne": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.47.0",
    "@tonehub/cube-baby-api": "workspace:*",
    "@tonehub/cube-baby-protocol": "workspace:*",
    "@tonehub/library-sync": "workspace:*",
    "@tonehub/midi-core": "workspace:*",
    "@tonehub/midi-host-android": "workspace:*",
    "@tonehub/midi-transport-native": "workspace:*",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.5",
    "expo-font": "~14.0.9",
    "expo-linking": "~57.0.7",
    "expo-modules-core": "~57.0.10",
    "expo-router": "~57.0.15",
    "expo-sharing": "^57.0.14",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "jszip": "^3.10.1",
    "pitchy": "^4.1.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.11.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2",
"babel-preset-expo": "~57.0.10"
},
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-font"
      ]
    }
  }
}
