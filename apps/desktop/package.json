{
  "name": "@tonehub/desktop",
  "productName": "CubeControl",
  "version": "0.1.2",
  "description": "CubeControl — USB editor for M-VAVE CUBE Baby (unofficial)",
  "author": "CubeControl contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "start": "vite",
    "icons": "node scripts/make-icon.mjs",
    "dist": "pnpm build && electron-builder --win --config electron-builder.yml -c.directories.output=%LOCALAPPDATA%/CubeControl-build",
    "dist:dir": "pnpm build && electron-builder --win --dir --config electron-builder.yml -c.directories.output=%LOCALAPPDATA%/CubeControl-build",
    "dist:portable": "pnpm build && electron-builder --win portable --config electron-builder.yml -c.directories.output=%LOCALAPPDATA%/CubeControl-build"
  },
  "dependencies": {
    "@julusian/midi": "^3.8.1",
    "@supabase/supabase-js": "^2.47.0",
    "@tonehub/cube-baby-api": "workspace:*",
    "@tonehub/cube-baby-protocol": "workspace:*",
    "@tonehub/library-sync": "workspace:*",
    "@tonehub/midi-core": "workspace:*",
    "@tonehub/midi-transport-node": "workspace:*",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "pitchy": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
